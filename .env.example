APP_NAME=SmartPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL WAJIB sama persis dengan ApiConfig.host di aplikasi mobile
# (SmartPro-mobile/lib/config/api_config.dart). Kalau berbeda, aplikasinya tetap
# jalan tetapi URL absolut yang dibangun server — foto profil pada /api/me,
# tautan & logo pada surel — menunjuk alamat yang salah. Rusak yang tak terlihat
# dari sisi aplikasi.
#   Uji di HP lewat Wi-Fi : http://<IP-laptop>:9090 (php artisan serve --host=0.0.0.0 --port=9090)
#   Produksi (Hostinger)  : https://adw.proworkppa.com
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# WITA — site Adaro. Seluruh cap waktu dokumen bergantung pada ini (PRD v3.1 §13).
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 via XAMPP (CLAUDE.md §2). Bukan sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartpro_refactor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── EMAIL ────────────────────────────────────────────────────────────────────
# Panduan lengkap + daftar pertanyaan untuk IT: docs/PANDUAN-PRODUKSI-EMAIL.md
#
# BAWAAN DI BAWAH = Mailpit (unduh mailpit.exe, jalankan; SMTP 1025, kotak
# masuk http://127.0.0.1:8025). Surel baru terkirim kalau `php artisan
# queue:work` JALAN — kanal mail diantrekan, kanal lonceng tidak.
#
# PRODUKSI: ganti `smtp` jadi `failover` = coba SMTP dulu, kalau mati tulis ke
# storage/logs/laravel.log — dengan `smtp` sendirian, relay yang mati membuat
# pekerjaannya gagal dan ISI EMAILNYA HILANG.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_ENCRYPTION SUDAH TIDAK DIBACA Laravel 11/12 - penggantinya MAIL_SCHEME
# di atas. Port 465 -> MAIL_SCHEME=smtps; port 587 -> MAIL_SCHEME kosong.
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Relay yang menggantung akan menahan pekerja antrean tanpa batas — bawaannya
# tak berbatas. Selalu isi di produksi.
MAIL_TIMEOUT=15

# Nama yang disebut server kita saat menyapa relay (EHLO). Bawaannya diambil
# dari host APP_URL, jadi kalau APP_URL berupa IP, EHLO mengirim IP TELANJANG —
# banyak relay korporat menolaknya dengan galat yang tak menyebut-nyebut EHLO.
# Isi dengan FQDN server bila APP_URL memakai IP.
# MAIL_EHLO_DOMAIN=smartpro.ppa.co.id

# KATUP PENGAMAN: belokkan SEMUA email ke satu alamat, berapa pun penerima
# aslinya. Nyalakan HANYA pada hari relay sungguhan pertama dipasang, lalu
# kosongkan lagi. Lonceng tidak terpengaruh.
# MAIL_PAKSA_KE=penguji@ppa-adro.local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SmartPro — AI Review Assist (PRD v3.1 §12)
# ---------------------------------------------------------------------------
# AI hanya MEMBANTU peninjau; ia tak pernah meloloskan/menolak dokumen sendiri.
# Kosongkan AI_ENABLED=false bila kunci belum tersedia — aplikasi tetap jalan
# (NullReviewer) dan halaman tinjau menampilkan pesan "AI sedang dinonaktifkan".
AI_ENABLED=true
AI_PROVIDER=openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Penyedia CADANGAN — dipakai HANYA bila panggilan ke penyedia utama gagal
# (kredit habis, key dicabut, penyedia tumbang). Boleh penyedia lain MAUPUN
# akun/key OpenRouter kedua, karena key & model-nya berdiri sendiri.
# Kosongkan AI_CADANGAN_PROVIDER untuk mematikan cadangan.
AI_CADANGAN_PROVIDER=
AI_CADANGAN_API_KEY=
AI_CADANGAN_MODEL=
