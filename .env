APP_NAME="SmartPro shadcn"
APP_ENV=local
APP_KEY=base64:ieMFB3Huw2g3OxqerO1in5beS70HjSvu6GoPSyB/I0g=
APP_DEBUG=true
# WAJIB sama dengan ApiConfig.host di SmartPro-mobile/lib/config/api_config.dart.
# Produksi: APP_URL=https://adw.proworkppa.com
APP_URL=http://10.7.147.254:9092

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartpro_shadcn
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mailpit (pengembangan lokal) ---
# Jalankan mailpit.exe; SMTP di 1025, kotak masuknya http://127.0.0.1:8025
# Surel baru terkirim kalau `php artisan queue:work` JALAN (QUEUE_CONNECTION=database).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="smartpro@proworkppa.com"
MAIL_FROM_NAME="SmartPro PT PPA"
# Dikosongkan: Mailpit sudah menangkap SEMUA surel, jadi Mail::alwaysTo() cuma
# menyembunyikan siapa penerima sebenarnya.
MAIL_PAKSA_KE=

# --- Produksi Hostinger (AKTIFKAN saat deploy, matikan blok Mailpit di atas) ---
# JANGAN pakai MAIL_ENCRYPTION: Laravel 11/12 TIDAK membacanya lagi
# (config/mail.php cuma membaca MAIL_SCHEME). Port 465 tanpa MAIL_SCHEME=smtps
# berarti kita bicara PLAINTEXT ke port TLS — koneksi menggantung sampai
# MAIL_TIMEOUT lalu pekerjaannya gagal, tanpa galat yang menyebut TLS.
#   port 465 -> MAIL_SCHEME=smtps
#   port 587 -> MAIL_SCHEME dikosongkan (STARTTLS otomatis)
MAIL_MAILER=failover
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=smartpro@proworkppa.com
MAIL_PASSWORD=Prosmart2022!
MAIL_TIMEOUT=15
# MAIL_FROM_ADDRESS harus SAMA PERSIS dengan MAIL_USERNAME (Hostinger menolak bila beda)
MAIL_EHLO_DOMAIN=adw.proworkppa.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SmartPro AI ---
# Ganti provider cukup dari sini: gemini | openrouter (harus punya key-nya)
AI_PROVIDER=openrouter
AI_ENABLED=true

# Gemini
GEMINI_API_KEY=AQ.Ab8RN6KcpPntrnCpzHBS6NkJy2wJsilBJDEAxJcoYrmxEKwN9g
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (OpenAI-compatible; pilih model apa pun dari openrouter.ai/models)
# Key lama — akun yang sama, kreditnya habis (402). Disimpan sebagai riwayat.
# OPENROUTER_API_KEY=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
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Cadangan — dipakai HANYA bila panggilan ke penyedia utama gagal.
# Key-nya SAMA dengan utama (baru ada satu akun); yang berbeda MODEL-nya, jadi
# cadangan ini menolong saat model utama kena 429/tumbang — BUKAN saat kreditnya
# habis. Ganti dengan key akun lain begitu ada, agar 402 pun tertutup.
AI_CADANGAN_PROVIDER=openrouter
AI_CADANGAN_API_KEY=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
